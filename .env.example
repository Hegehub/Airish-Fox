# Production-oriented example. For local dev you may switch to config.settings.dev and DEBUG=True.
DJANGO_SETTINGS_MODULE=config.settings.prod
APP_ENV=production
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
ADMIN_URL=secure-admin/
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=5/600
RATE_LIMIT_CHECKOUT=8/300
RATE_LIMIT_PAYMENT_CREATE=12/300
ANTOM_ENV=sandbox
ANTOM_GATEWAY_URL=
ANTOM_CLIENT_ID=
ANTOM_MERCHANT_PRIVATE_KEY=
ANTOM_PUBLIC_KEY=
ANTOM_KEY_VERSION=
ANTOM_PAYMENT_CURRENCY=VND
ANTOM_NOTIFY_URL=
ANTOM_RETURN_URL=
ANTOM_TIMEOUT_SECONDS=20
ANTOM_PAYMENTS_ENABLED=False
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_ZOOM=15
